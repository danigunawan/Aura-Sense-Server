# AuraSense NVR — environment configuration template.
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─── Camera credentials ───────────────────────────────────────────────────────
# All Prama cameras are pre-configured with the same credentials.

# ONVIF credentials (used for camera discovery, auto-configuration, PTZ).
CAMERA_ONVIF_USER=admin
CAMERA_ONVIF_PASS=Aurasmart7*

# RTSP credentials (embedded in stream URLs for live view and recording).
# These are the same as ONVIF if your cameras use unified auth.
CAMERA_RTSP_USER=admin
CAMERA_RTSP_PASS=Aurasmart7*

# ─── Camera allowlist ────────────────────────────────────────────────────────
# Only cameras matching this manufacturer are accepted. Others are silently skipped.
# Run `python main.py --probe` first to discover what your cameras actually report.
CAMERA_ALLOWED_MANUFACTURER=ONVIF,PRAMA,CPPLUS

# Extra credential pairs tried in order when primary credentials fail (JSON).
# Add one entry per brand that uses a different password to the primary Prama pair.
CAMERA_EXTRA_CREDENTIALS=[{"onvif_user":"admin","onvif_pass":"Aurasmart7**","rtsp_user":"admin","rtsp_pass":"Aurasmart7**"}]

# Optional: comma-separated model substrings (case-insensitive).
# Leave empty to accept all models from the above manufacturer.
# Example: CAMERA_ALLOWED_MODELS=2MP Bullet,2MP Dome,4MP Bullet,4MP Dome
CAMERA_ALLOWED_MODELS=

# ─── Discovery timing ────────────────────────────────────────────────────────
DISCOVERY_INTERVAL=60
DISCOVERY_TIMEOUT=5.0
ONVIF_TIMEOUT=10

# ─── Camera auto-configuration ───────────────────────────────────────────────
# GOP length set on camera main stream via ONVIF for low-latency WebRTC start.
# 25 = 1 second keyframe interval at 25 fps. Set to 0 to disable.
CAMERA_AUTO_CONFIGURE_GOP=25

# ─── mediamtx integration ────────────────────────────────────────────────────
MEDIAMTX_API=http://127.0.0.1:9997
MEDIAMTX_BASE_YML=/home/aura/Documents/aurasense/mediamtx-conf/mediamtx-base.yml
MEDIAMTX_YML=/home/aura/Documents/aurasense/mediamtx-conf/mediamtx.yml

# ─── Storage ─────────────────────────────────────────────────────────────────
DB_PATH=/home/aura/Documents/aurasense/camera_discovery/cameras.db

# ─── API Gateway ─────────────────────────────────────────────────────────────
API_SECRET_KEY=c2e065050a3a28e78743f2eb355d68eefe5a940dc898b4d67e4e99c27f786643
REDIS_URL=redis://127.0.0.1:6379/0

# ─── Static IP pool (admin "Push Static IP" button) ──────────────────────────
# When the operator clicks the 🌐 button on a camera row in Settings, the
# discovery service picks the next free IP in this range and pushes it onto
# the camera via ONVIF SetNetworkInterfaces. The pool must NOT overlap with
# the dnsmasq DHCP range (.10–.99) configured in deploy/00b-camera-dhcp.sh.
CAMERA_STATIC_IP_POOL_START=10.42.0.100
CAMERA_STATIC_IP_POOL_END=10.42.0.250
CAMERA_STATIC_IP_GATEWAY=10.42.0.1
CAMERA_STATIC_IP_PREFIX_LEN=24
CAMERA_STATIC_IP_DNS=10.42.0.1
# Leave CAMERA_STATIC_IP_ENABLED=false to keep auto-assignment on first
# discovery off — the manual button works regardless of this flag.
CAMERA_STATIC_IP_ENABLED=false

# ─── Logging ─────────────────────────────────────────────────────────────────
# Set to DEBUG for verbose ONVIF output. Inline `#` comments are not stripped by
# systemd's EnvironmentFile, so keep the value on its own line.
LOG_LEVEL=INFO
DISCOVERY_INTERFACE=10.42.0.1
