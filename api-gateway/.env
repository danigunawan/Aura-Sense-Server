PORT=8000

# Shared SQLite DB with camera_discovery service
DB_PATH=/home/aura/Documents/aurasense/camera_discovery/cameras.db

# App-level JWT (user sessions)
APP_SECRET=8bbb9f9589a738c40515e621be7f931a46f632992c64acc104ddc5f5a521d214

# MUST match signaling-server JWT_SECRET — used to mint viewer device tokens
SIGNALING_JWT_SECRET=4761df2ca84e70532de05e416851486dd9120159542d20a1304c1aedd43440ad
SIGNALING_URL=wss://localhost:8080/signal

# The NVR's registered device ID on the signaling server

# Redis — same instance as signaling server
REDIS_URL=redis://localhost:6379

# Where FFmpeg writes recordings (used for clip downloads)
RECORDINGS_PATH=/recordings

DEFAULT_ADMIN_PASSWORD=aura4211

# Seconds a viewer stream session token stays valid (default 2h)
STREAM_SESSION_TTL=7200

LOG_LEVEL=info

# TURN server — leave empty to use STUN-only (works for Jio/Airtel via IPv6)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# Cloudflare Tunnel
MEDIAMTX_HLS_URL=https://stream-1c697a92f0dc.latigidautomations.com
MEDIAMTX_URL=https://webrtc-1c697a92f0dc.latigidautomations.com
NVR_DEVICE_ID=1c697a92f0dc
