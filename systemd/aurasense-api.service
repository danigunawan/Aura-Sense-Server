[Unit]
Description=AuraSense API gateway (FastAPI/uvicorn)
After=network-online.target redis.service aurasense-mediamtx.service
Wants=network-online.target
PartOf=aurasense.target

[Service]
# Type=notify: main.py's lifespan calls `systemd-notify --ready` once db,
# Redis, and routes are wired. NotifyAccess=all lets the subprocess send it
# on uvicorn's behalf (default `main` rejects child PIDs).
Type=notify
NotifyAccess=all
TimeoutStartSec=180
User=aura
WorkingDirectory=/home/aura/Documents/aurasense/api-gateway
ExecStart=/home/aura/Documents/aurasense/api-gateway/.venv/bin/uvicorn \
          main:app --host 0.0.0.0 --port 8000 --no-access-log

Restart=always
RestartSec=5

TimeoutStopSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=aurasense-api

[Install]
WantedBy=aurasense.target
