[Unit]
Description=AuraSense lobby encoder (FFmpeg H.265→H.264)
After=network-online.target aurasense-mediamtx.service
Wants=network-online.target
Requires=aurasense-mediamtx.service
PartOf=aurasense.target

[Service]
Type=simple
User=aura
ExecStart=/usr/bin/ffmpeg \
          -rtsp_transport tcp \
          -i "rtsp://admin:Ashwani7*@192.168.0.111:554/Streaming/Unicast/channels/101" \
          -c:v libx264 -preset ultrafast -tune zerolatency \
          -b:v 1500k -g 25 -keyint_min 25 -sc_threshold 0 \
          -c:a aac -b:a 64k \
          -f rtsp rtsp://127.0.0.1:8554/lobby
Restart=always
RestartSec=15
StartLimitIntervalSec=0
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aurasense-lobby-encoder

[Install]
WantedBy=aurasense.target
